NODE_ENV=development
PORT=5001
# Local replica set for this project. Use port 27017 only if the Windows MongoDB service has replication enabled.
MONGO_URI=mongodb://127.0.0.1:27018/stocksense?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-this-with-a-long-random-string
# Password reset email. For Gmail use smtp.gmail.com, port 587, SMTP_SECURE=false, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StockSense <you@gmail.com>
